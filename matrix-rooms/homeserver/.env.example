# Copy to .env and set before the first `docker compose run --rm synapse generate`.
#
# SYNAPSE_SERVER_NAME is the identity suffix in every user/room id (@user:THIS).
# It is IRREVERSIBLE once `generate` has run — choose deliberately.
#   production federation identity:  microserver.network
#   prototype (validated) ran on:    quantiota.net   (the existing AI Agent Lab instance)
SYNAPSE_SERVER_NAME=microserver.network
